---
// Site header + primary nav. Edit the links here to add/remove sections.
// Note: a topic page only exists once at least one article uses that topic.
// Add links here as you publish into new topics (Sightings, Science, …).
const nav = [
  { href: '/', label: 'Latest' },
  { href: '/sightings', label: 'Wire' },
  { href: '/topics/government-disclosure', label: 'Disclosure' },
  { href: '/topics/analysis', label: 'Analysis' },
  { href: '/topics/history', label: 'History' },
  { href: '/map', label: 'Map' },
  { href: '/field-guide', label: 'Field Guide' },
  { href: '/about', label: 'About' },
];
---
<div class="classification-bar">
  <div class="inner">
    <span><span class="redact">◤ TOP SECRET</span> &nbsp;//&nbsp; UAP&nbsp;//&nbsp;NOFORN</span>
    <span class="right">DECLASSIFIED FOR PUBLIC RELEASE &nbsp;·&nbsp; FILE&nbsp;REF&nbsp;UAP-████</span>
  </div>
</div>
<header class="site-header">
  <div class="bar">
    <a href="/" class="brand" aria-label="UAP Times — home">
      <img src="/images/logo.svg" alt="UAP Times" class="brand-logo" width="640" height="150" />
    </a>
    <nav class="nav">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/rss.xml" title="RSS feed" aria-label="RSS feed">RSS</a>
      <button type="button" class="nav-search" id="search-open" aria-label="Search" title="Search (press /)">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7" /><line x1="16.5" y1="16.5" x2="21" y2="21" />
        </svg>
        <span>Search</span>
      </button>
    </nav>
  </div>
</header>

<div class="search-overlay" id="search-overlay" hidden>
  <div class="search-backdrop" data-search-close></div>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search UAP Times">
    <div class="search-head">
      <span class="search-title">◈ Query the archive</span>
      <button type="button" class="search-x" data-search-close aria-label="Close search">ESC ✕</button>
    </div>
    <div class="search-inputwrap">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <circle cx="11" cy="11" r="7" /><line x1="16.5" y1="16.5" x2="21" y2="21" />
      </svg>
      <input id="search-input" type="search" autocomplete="off" spellcheck="false"
             placeholder="Search articles, sightings, craft types…" aria-label="Search query" />
    </div>
    <div class="search-results" id="search-results" role="listbox" aria-label="Search results">
      <p class="search-hint">Type to search — articles, map cases, craft types and pages.</p>
    </div>
  </div>
</div>

<script>
  (() => {
    const overlay = document.getElementById('search-overlay');
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    const openBtn = document.getElementById('search-open');
    if (!overlay || !input || !results) return;

    let index = null, loading = false, sel = -1, hits = [], timer = 0;

    const load = async () => {
      if (index || loading) return;
      loading = true;
      try {
        const res = await fetch('/search-index.json');
        index = await res.json();
      } catch (e) { index = []; }
      loading = false;
      if (input.value.trim()) run(input.value);
    };

    const open = () => {
      overlay.hidden = false;
      document.documentElement.classList.add('search-lock');
      load();
      setTimeout(() => input.focus(), 20);
    };
    const close = () => {
      overlay.hidden = true;
      document.documentElement.classList.remove('search-lock');
    };

    const esc = (s) => String(s).replace(/[&<>"]/g, (m) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]));
    const rxEsc = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

    const hl = (text, terms) => {
      let out = esc(text || '');
      for (const t of terms) {
        if (t.length < 2) continue;
        out = out.replace(new RegExp('(' + rxEsc(t) + ')', 'ig'), '<mark>$1</mark>');
      }
      return out;
    };

    const score = (item, terms) => {
      const title = (item.title || '').toLowerCase();
      const tagStr = ((item.tags || []).join(' ') + ' ' + (item.meta || '')).toLowerCase();
      const desc = (item.desc || '').toLowerCase();
      const body = (item.body || '').toLowerCase();
      let total = 0;
      for (const t of terms) {
        let s = 0;
        if (title.includes(t)) s += title.startsWith(t) ? 12 : 8;
        if (tagStr.includes(t)) s += 4;
        if (desc.includes(t)) s += 2;
        if (body.includes(t)) s += 1;
        if (s === 0) return 0;            // every term must match somewhere
        total += s;
      }
      return total;
    };

    const run = (q) => {
      const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
      if (!terms.length) {
        hits = []; sel = -1;
        results.innerHTML = '<p class="search-hint">Type to search — articles, map cases, craft types and pages.</p>';
        return;
      }
      if (!index) { results.innerHTML = '<p class="search-hint">Loading index…</p>'; return; }
      hits = index
        .map((it) => ({ it, s: score(it, terms) }))
        .filter((r) => r.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 12)
        .map((r) => r.it);
      sel = hits.length ? 0 : -1;
      if (!hits.length) {
        results.innerHTML = `<p class="search-hint">No matches for “${esc(q)}”.</p>`;
        return;
      }
      results.innerHTML = hits.map((h, i) =>
        `<a class="search-hit${i === 0 ? ' is-sel' : ''}" href="${esc(h.url)}" data-i="${i}" role="option">` +
          `<span class="search-hit-type">${esc(h.type)}</span>` +
          `<span class="search-hit-main">` +
            `<span class="search-hit-title">${hl(h.title, terms)}</span>` +
            `<span class="search-hit-desc">${hl(h.desc, terms)}</span>` +
          `</span>` +
        `</a>`
      ).join('');
    };

    const move = (d) => {
      if (!hits.length) return;
      const nodes = results.querySelectorAll('.search-hit');
      nodes[sel]?.classList.remove('is-sel');
      sel = (sel + d + hits.length) % hits.length;
      const n = nodes[sel];
      n?.classList.add('is-sel');
      n?.scrollIntoView({ block: 'nearest' });
    };

    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => run(input.value), 110);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
      else if (e.key === 'Enter') {
        const n = results.querySelectorAll('.search-hit')[sel];
        if (n) { e.preventDefault(); window.location.href = n.getAttribute('href'); }
      }
    });

    openBtn && openBtn.addEventListener('click', open);
    overlay.querySelectorAll('[data-search-close]').forEach((b) => b.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hidden) close();
      else if (e.key === '/' && overlay.hidden) {
        const tag = (document.activeElement && document.activeElement.tagName) || '';
        if (tag !== 'INPUT' && tag !== 'TEXTAREA') { e.preventDefault(); open(); }
      }
    });
  })();
</script>
