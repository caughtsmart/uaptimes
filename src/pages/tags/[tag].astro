---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

// One page per tag — but ONLY for tags shared by two or more articles.
// Single-use tags would create thin, near-empty pages (an SEO liability),
// so they get no page and are rendered as plain text on the article.
export async function getStaticPaths() {
  const slugify = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const articles = await getCollection('articles', ({ data }) => !data.draft);

  const byTag = new Map(); // slug -> { label, articles }
  for (const a of articles) {
    for (const tag of a.data.tags) {
      const slug = slugify(tag);
      if (!slug) continue;
      if (!byTag.has(slug)) byTag.set(slug, { label: tag, articles: [] });
      byTag.get(slug).articles.push(a);
    }
  }

  return [...byTag.entries()]
    .filter(([, v]) => v.articles.length >= 2)
    .map(([slug, v]) => ({
      params: { tag: slug },
      props: {
        label: v.label,
        articles: v.articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
      },
    }));
}

const { label, articles } = Astro.props;
---
<BaseLayout
  title={`${label}: UAP coverage`}
  description={`Every UAP Times article tagged ${label} — ${articles.length} in-depth reports and case files.`}
>
  <div class="container">
    <div class="article-header prose">
      <span class="topic-tag">Tag</span>
      <h1>#{label}</h1>
      <p class="lede">{articles.length} articles tagged “{label}”.</p>
    </div>
    <div class="card-grid">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
    <div class="prose"><a class="back-link" href="/">← Back to the latest</a></div>
  </div>
</BaseLayout>
