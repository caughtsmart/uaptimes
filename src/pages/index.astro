---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

// Pull all non-draft articles, newest first.
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [lead, ...rest] = articles;
---
<BaseLayout title="UAP Times">
  <section class="masthead">
    <video
      class="masthead-bg-video"
      muted loop playsinline
      preload="none"
      poster="/images/masthead-ufo.png"
      data-src="/images/masthead-ufo.mp4"
      aria-hidden="true"
    ></video>
    <script is:inline>
      // Only load & play the clip on wider screens with motion allowed —
      // phones and reduced-motion users get the lightweight still poster,
      // and never download the video at all.
      (function () {
        var v = document.querySelector('.masthead-bg-video');
        if (!v) return;
        var ok = window.matchMedia('(min-width: 700px)').matches &&
                 !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!ok) return;
        v.src = v.dataset.src;
        v.load();
        var go = function () { var p = v.play(); if (p && p.catch) p.catch(function () {}); };
        if (v.readyState >= 2) go(); else v.addEventListener('loadeddata', go, { once: true });
      })();
    </script>
    <div class="masthead-grain" aria-hidden="true"></div>
    <div class="rec-hud" aria-hidden="true">
      <span class="rec-dot"></span>REC<span class="rec-tc">00:37:14</span>
    </div>
    <div class="decl-stamp" aria-hidden="true">
      <span class="decl-stamp__main">Declassified</span>
      <span class="decl-stamp__sub">Auth · UAP Times</span>
    </div>
    <h1>Declassified Dispatches</h1>
    <p>UAP news, filed from the edge of the known.</p>
    <div class="rule"></div>
  </section>

  <div class="container">
    {lead && (
      <>
        <h2 class="section-title">Lead story</h2>
        <div class="card-grid" style="grid-template-columns:1fr;">
          <ArticleCard article={lead} />
        </div>
      </>
    )}

    <h2 class="section-title">Latest dispatches</h2>
    <div class="card-grid">
      {rest.map((article) => <ArticleCard article={article} />)}
    </div>
  </div>
</BaseLayout>
