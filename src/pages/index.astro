---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EmailSignup from '../components/EmailSignup.astro';

// Pull all non-draft articles, newest first.
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [lead, ...rest] = articles;
---
<BaseLayout title="UAP Times">
  <section class="masthead">
    <video
      class="masthead-bg-video"
      autoplay muted loop playsinline
      preload="metadata"
      poster="/images/masthead-bg.png"
      aria-hidden="true"
    >
      <source src="/images/masthead-bg.mp4" type="video/mp4" />
    </video>
    <div class="decl-stamp" aria-hidden="true">
      <span class="decl-stamp__main">Declassified</span>
      <span class="decl-stamp__sub">Auth · UAP Times</span>
    </div>
    <h1>Declassified Dispatches</h1>
    <p>UAP news, filed from the edge of the known.</p>
    <div class="rule"></div>
  </section>

  <div class="container">
    {lead && (
      <>
        <h2 class="section-title">Lead story</h2>
        <div class="card-grid" style="grid-template-columns:1fr;">
          <ArticleCard article={lead} />
        </div>
      </>
    )}

    <h2 class="section-title">Latest dispatches</h2>
    <div class="card-grid">
      {rest.map((article) => <ArticleCard article={article} />)}
    </div>

    <EmailSignup />
  </div>
</BaseLayout>
