---
import BaseLayout from '../layouts/BaseLayout.astro';
import wire from '../data/live-sightings.json';

// The Live Sightings Wire: short paragraphs of the latest UAP chatter, pulled
// hourly from open sources by scripts/fetch-sightings.mjs and committed to
// live-sightings.json. This page just renders whatever is in that file.
const items = wire.items ?? [];
const notable = items.filter((i) => i.notable);
const rest = items.filter((i) => !i.notable);

const updated = wire.updated ? new Date(wire.updated) : null;
const updatedStr = updated
  ? updated.toLocaleString('en-GB', {
      day: 'numeric', month: 'short', year: 'numeric',
      hour: '2-digit', minute: '2-digit', timeZone: 'UTC',
    }) + ' UTC'
  : 'unknown';

function ago(iso) {
  if (!iso) return '';
  const then = new Date(iso).getTime();
  if (Number.isNaN(then)) return '';
  const mins = Math.round((Date.now() - then) / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.round(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  const days = Math.round(hrs / 24);
  return `${days}d ago`;
}

const kindLabel = { news: 'PRESS', social: 'SOCIAL' };

const title = 'Live Sightings Wire';
const description =
  'The latest UAP and UFO sighting reports, pulled hourly from open press and social sources. Short, raw, unverified — the notable ones flagged.';
---
<BaseLayout title={title} description={description}>
  <div class="container wire">
    <header class="wire-head">
      <span class="mono-label wire-kicker">◈ Incoming · unverified traffic</span>
      <h1>Live Sightings Wire</h1>
      <p class="wire-sub">
        Raw UAP chatter, swept hourly from open press and social feeds and dropped
        here newest-first. Nothing here is confirmed — it's the intake tray, not the
        archive. The ones our filter thinks are worth a second look are
        <span class="flag-inline">⚑ flagged</span>.
      </p>
      <div class="wire-status mono-label">
        <span class="live-dot" aria-hidden="true"></span>
        {items.length} signals · {notable.length} notable · last swept {updatedStr}
        {wire.seed && <span class="seed-note"> · sample data — the hourly crawl replaces this</span>}
      </div>
    </header>

    {notable.length > 0 && (
      <section class="wire-section">
        <h2 class="section-title">⚑ Flagged for a second look</h2>
        <ol class="wire-list">
          {notable.map((it) => (
            <li class="wire-item is-notable">
              <div class="wire-meta mono-label">
                <span class={`src-tag src-${it.sourceType}`}>{kindLabel[it.sourceType] ?? 'WIRE'}</span>
                <span class="src-name">{it.source}</span>
                <span class="dot">·</span>
                <time datetime={it.date}>{ago(it.date)}</time>
              </div>
              <p class="wire-text">{it.summary || it.title}</p>
              {it.signals?.length > 0 && (
                <div class="wire-signals">
                  {it.signals.map((s) => <span class="signal">{s}</span>)}
                </div>
              )}
              {it.url && (
                <a class="wire-src-link" href={it.url} target="_blank" rel="noopener nofollow">
                  Source ↗
                </a>
              )}
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="wire-section">
      <h2 class="section-title">Everything else on the wire</h2>
      {rest.length === 0 ? (
        <p class="wire-empty">The wire is quiet. Check back after the next hourly sweep.</p>
      ) : (
        <ol class="wire-list">
          {rest.map((it) => (
            <li class="wire-item">
              <div class="wire-meta mono-label">
                <span class={`src-tag src-${it.sourceType}`}>{kindLabel[it.sourceType] ?? 'WIRE'}</span>
                <span class="src-name">{it.source}</span>
                <span class="dot">·</span>
                <time datetime={it.date}>{ago(it.date)}</time>
              </div>
              <p class="wire-text">{it.summary || it.title}</p>
              {it.url && (
                <a class="wire-src-link" href={it.url} target="_blank" rel="noopener nofollow">
                  Source ↗
                </a>
              )}
            </li>
          ))}
        </ol>
      )}
    </section>

    <p class="wire-foot mono-label">
      Sources: open press (Google News), Bluesky &amp; Reddit public feeds. Unverified
      user reports — treat accordingly. Spotted something yourself?
      <a href="mailto:tips@uaptimes.com">tips@uaptimes.com</a>
    </p>
  </div>
</BaseLayout>

<style>
  .wire { max-width: var(--maxw); padding-top: 2rem; padding-bottom: 3rem; }

  .wire-head { margin-bottom: 2rem; }
  .wire-kicker { color: var(--accent); display: block; margin-bottom: .5rem; }
  .wire-head h1 { font-family: var(--font-head); font-size: 2.4rem; margin: 0 0 .5rem; }
  .wire-sub { color: var(--text-dim); margin: 0 0 1rem; }
  .flag-inline { color: var(--accent); font-weight: 600; }

  .wire-status {
    display: flex; flex-wrap: wrap; align-items: center; gap: .4rem;
    color: var(--text-dim); border-top: 1px solid var(--border);
    padding-top: .75rem; letter-spacing: .12em;
  }
  .seed-note { color: var(--warn); text-transform: none; letter-spacing: .02em; }
  .live-dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--accent);
    box-shadow: 0 0 0 0 rgba(177,42,29,.5); animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 rgba(177,42,29,.45); }
    70%  { box-shadow: 0 0 0 7px rgba(177,42,29,0); }
    100% { box-shadow: 0 0 0 0 rgba(177,42,29,0); }
  }
  @media (prefers-reduced-motion: reduce) { .live-dot { animation: none; } }

  .wire-section { margin-bottom: 2.5rem; }

  .wire-list { list-style: none; margin: 0; padding: 0; }
  .wire-item {
    background: var(--paper); border: 1px solid var(--border);
    border-radius: 6px; padding: 1rem 1.1rem; margin-bottom: .85rem;
    box-shadow: var(--shadow);
  }
  .wire-item.is-notable { border-left: 3px solid var(--accent); }

  .wire-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: .5rem;
    color: var(--text-dim); margin-bottom: .5rem; letter-spacing: .1em;
  }
  .src-tag {
    padding: .1rem .4rem; border-radius: 3px; color: var(--paper);
    background: var(--text-dim); letter-spacing: .1em; font-size: .62rem;
  }
  .src-tag.src-news { background: var(--link); }
  .src-tag.src-social { background: var(--warn); }
  .src-name { color: var(--text); text-transform: none; letter-spacing: .02em; }
  .dot { opacity: .5; }

  .wire-text {
    margin: 0; color: var(--text); line-height: 1.6;
    font-size: 1.02rem;
  }

  .wire-signals { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .6rem; }
  .signal {
    font-family: var(--font-mono); font-size: .64rem; text-transform: uppercase;
    letter-spacing: .08em; color: var(--accent-deep);
    background: rgba(177,42,29,.07); border: 1px solid var(--accent-dim);
    padding: .1rem .45rem; border-radius: 3px;
  }

  .wire-src-link {
    display: inline-block; margin-top: .55rem;
    font-family: var(--font-mono); font-size: .72rem; letter-spacing: .04em;
  }

  .wire-empty { color: var(--text-dim); font-style: italic; }

  .wire-foot {
    border-top: 1px solid var(--border); padding-top: 1rem; margin-top: 2rem;
    color: var(--text-dim); text-transform: none; letter-spacing: .02em;
    line-height: 1.6;
  }
  .wire-foot a { font-family: var(--font-mono); }
</style>
