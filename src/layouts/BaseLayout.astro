---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  seoTitle?: string;       // shorter title for <title>/social; falls back to title
  description?: string;
  image?: string;          // absolute path e.g. /images/foo.jpg for social cards
  imageAlt?: string;       // alt text for the social card image
  imageWidth?: number;     // social card pixel size — defaults to the 1376x768
  imageHeight?: number;    // article hero size when the image is a PNG
  article?: boolean;       // sets og:type article
  publishedTime?: Date;
  modifiedTime?: Date;     // last updated — feeds article:modified_time + dateModified
  section?: string;        // article topic, e.g. "History"
  tags?: string[];         // article tags, used for article:tag + JSON-LD keywords
  author?: string;
}

const SITE_DESCRIPTION =
  'UAP news, filed from the edge of the known. Credible reporting on UFOs, disclosure, and the unexplained.';

const {
  title,
  seoTitle,
  description = SITE_DESCRIPTION,
  image = '/images/masthead-ufo.png',
  imageAlt,
  imageWidth,
  imageHeight,
  article = false,
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  author = 'UAP Times Desk',
} = Astro.props;

const siteName = 'UAP Times';
const metaTitle = seoTitle || title;
const fullTitle = metaTitle === siteName ? metaTitle : `${metaTitle} — ${siteName}`;

const slugify = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// Google truncates meta/social descriptions around 155–160 chars. Our article
// ledes are longer (they double as the on-page intro), so clip a tidy version
// at a word boundary for the tags only — the on-page lede stays full.
function clip(s: string, n = 160): string {
  if (!s || s.length <= n) return s;
  const cut = s.slice(0, n - 1);
  const sp = cut.lastIndexOf(' ');
  return (sp > 40 ? cut.slice(0, sp) : cut).replace(/[\s.,;:—–-]+$/, '') + '…';
}
const metaDescription = clip(description);
const socialAlt = imageAlt || fullTitle;

// Astro.site comes from `site` in astro.config.mjs
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const logo = new URL('/images/logo.svg', Astro.site);
// Social card type + dimensions. Every hero PNG the pipeline produces is
// 1376x768, so that stays the default; anything else (a JPEG or WebP card)
// has to declare its own size, and gets the right MIME type either way.
const isImagePng = /\.png$/i.test(image);
const socialType = isImagePng
  ? 'image/png'
  : /\.jpe?g$/i.test(image)
    ? 'image/jpeg'
    : /\.webp$/i.test(image)
      ? 'image/webp'
      : null;
const socialWidth = imageWidth ?? (isImagePng ? 1376 : null);
const socialHeight = imageHeight ?? (isImagePng ? 768 : null);

const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      headline: title.slice(0, 110),
      description: metaDescription,
      image: [socialImage.toString()],
      url: canonical.toString(),
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.toString() },
      ...(publishedTime ? { datePublished: publishedTime.toISOString() } : {}),
      dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
      author: { '@type': 'Organization', name: author },
      publisher: {
        '@type': 'Organization',
        name: siteName,
        logo: { '@type': 'ImageObject', url: logo.toString() },
      },
      ...(section ? { articleSection: section } : {}),
      ...(tags.length ? { keywords: tags.join(', ') } : {}),
      isAccessibleForFree: true,
      inLanguage: 'en-GB',
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      url: new URL('/', Astro.site).toString(),
      description: metaDescription,
      inLanguage: 'en-GB',
      publisher: {
        '@type': 'Organization',
        name: siteName,
        logo: { '@type': 'ImageObject', url: logo.toString() },
      },
    };

// Breadcrumb trail (Home › Topic › Article) — can surface as breadcrumb
// rich results in Google and clarifies site structure to crawlers.
const breadcrumb =
  article && section
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
          { '@type': 'ListItem', position: 2, name: section, item: new URL(`/topics/${slugify(section)}/`, Astro.site).toString() },
          { '@type': 'ListItem', position: 3, name: title, item: canonical.toString() },
        ],
      }
    : null;

// Preload the article hero — it's the Largest Contentful Paint element, so
// preloading it improves LCP (a Core Web Vitals ranking signal).
const preloadHero = article && /\.(png|jpe?g|webp)$/i.test(image) ? image : null;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e9e6dc" />
    <meta name="google-site-verification" content="FRVl-CAgyDRB9bAQdyTX_eiZYcUeMsD9rbp-tci4d0M" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    {preloadHero && <link rel="preload" as="image" href={preloadHero} fetchpriority="high" />}

    <!-- Open Graph / social share cards -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialAlt} />
    {socialType && <meta property="og:image:type" content={socialType} />}
    {socialWidth && <meta property="og:image:width" content={String(socialWidth)} />}
    {socialHeight && <meta property="og:image:height" content={String(socialHeight)} />}
    {article && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {article && (modifiedTime ?? publishedTime) && <meta property="article:modified_time" content={(modifiedTime ?? publishedTime)!.toISOString()} />}
    {article && <meta property="article:author" content={author} />}
    {article && section && <meta property="article:section" content={section} />}
    {article && tags.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialAlt} />

    <!-- JSON-LD structured data helps Google understand you're a news site -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
