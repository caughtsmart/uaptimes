---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ShareBar from '../components/ShareBar.astro';

interface Props { article: CollectionEntry<'articles'>; }
const { article } = Astro.props;
const { data } = article;

const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();

const dateStr = data.pubDate.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});
const credLabel = ['', 'Well-sourced', 'Credible', 'Unconfirmed', 'Thin', 'Take with salt'][data.credibility];

// Work out which tags have their own hub page (used by 2+ articles). Only
// those become links; single-use tags render as plain text so we don't link
// to thin pages that don't exist.
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const tagCounts = new Map<string, number>();
for (const a of allArticles) {
  for (const t of a.data.tags) tagCounts.set(slugify(t), (tagCounts.get(slugify(t)) ?? 0) + 1);
}
const topicSlug = slugify(data.topic);
---
<BaseLayout
  title={data.title}
  seoTitle={data.seoTitle}
  description={data.description}
  image={data.heroImage}
  imageAlt={data.title}
  article={true}
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
  section={data.topic}
  tags={data.tags}
  author={data.author}
>
  <article class="container">
    <header class="article-header prose">
      <span class="topic-tag">{data.topic}</span>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
      <div class="meta-row" style="justify-content:center; margin-top:1rem;">
        <span>By {data.author}</span>
        <span>·</span>
        <span>{dateStr}</span>
        <span>·</span>
        <a class="cred cred-link" href="/about#how-we-rate" title="How we rate credibility (a sourcing scale)">◈ {credLabel}</a>
      </div>
    </header>

    {data.heroImage && (
      <figure class="hero-figure">
        <img
          src={data.heroImage}
          alt={data.title}
          width="1376"
          height="768"
          decoding="async"
          fetchpriority="high"
        />
        {data.heroCredit && <figcaption>{data.heroCredit}</figcaption>}
      </figure>
    )}

    <div class="article-body prose">
      <slot />

      {data.source && (
        <p style="color:var(--text-dim); font-size:.9rem; border-top:1px solid var(--border); padding-top:1rem; margin-top:2rem;">
          <strong>Source:</strong>{' '}
          {data.sourceUrl
            ? <a href={data.sourceUrl}>{data.source}</a>
            : data.source}
        </p>
      )}

      {data.tags.length > 0 && (
        <div class="tag-list">
          {data.tags.map((t) => (
            (tagCounts.get(slugify(t)) ?? 0) >= 2
              ? <a href={`/tags/${slugify(t)}/`}>#{t}</a>
              : <span>#{t}</span>
          ))}
        </div>
      )}

      <ShareBar url={shareUrl} title={data.title} />
    </div>

    <div class="prose"><a class="back-link" href="/">← Back to the latest</a></div>
  </article>
</BaseLayout>
